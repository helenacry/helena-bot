# Ambiente de PRODUÇÃO (copie para .env e preencha).
# Para testes, use o .env.test.example -> .env.test (npm run start:test).

# Token do bot (Portal do Desenvolvedor da VSync -> aplicativo -> Bot).
VSYNC_BOT_TOKEN=

# IDs dos proprietários da Helena (comandos /dev* e selo DEV no perfil).
# Aceita vários IDs separados por vírgula, em UUID ou numérico.
HELENA_OWNER_ID=

# IDs autorizados a usar os comandos /admin* (separados por vírgula).
HELENA_ADMIN_IDS=

# Banco SQLite do ambiente. Sem a variável, usa ./data/helena.db.
HELENA_DATABASE_PATH=./data/helena.db

# Bolsa (/bolsa): o índice do servidor mexe nos preços da loja. Ligada por
# padrão; "off" deixa todos os preços na tabela.
HELENA_MARKET=on

# Intervalo de 3 segundos entre os comandos da mesma pessoa (barra e prefixo h),
# para o bot não ser sobrecarregado. Ligado por padrão; "off" desliga. Vale
# também para o dono (config/anti-spam.mjs tem a opção exemptOwners).
HELENA_ANTI_SPAM=on

# Componentes V2 da VSync no lugar dos embeds (README, "Componentes V2"):
#   off    (padrão) tudo como embed
#   owner  só nas respostas do dono (HELENA_OWNER_ID), para testar em produção
#   on     para todo mundo
# Se a VSync recusar o layout, a resposta sai como embed e o log avisa.
HELENA_V2=off

# Contadores do servidor de suporte (services/platform/support-stats.mjs).
# Se qualquer um destes estiver vazio, os contadores ficam desligados.
HELENA_SUPPORT_GUILD_ID=
HELENA_USERS_CHANNEL_ID=
HELENA_CLUSTERS_CHANNEL_ID=
HELENA_CLUSTER_TOTAL=1
HELENA_STATS_INTERVAL=300000

# Ícones das insígnias do /userinfo (services/social/badge-emojis.mjs): o servidor onde estão os
# emojis auto_* (um ou mais IDs, separados por vírgula). Vazio: vale o HELENA_SUPPORT_GUILD_ID e,
# sem ele, a Helena procura nos primeiros servidores em que está. Sem os emojis, o /userinfo usa
# os fixos e o nome da insígnia. Para enviar os ícones: scripts/dev/upload-badge-emojis.mjs.
HELENA_BADGE_GUILD_ID=

# ---------------------------------------------------------------------------
# Painel do site (daily e gemas pelo navegador). Opcional.
# Deixe HELENA_WEB_PORT vazia para manter a API desligada (padrão).
# Detalhes no README, seção "Painel do site (API)".
# ---------------------------------------------------------------------------

# Porta da API. Ela escuta só no próprio computador (HELENA_WEB_HOST);
# para o site alcançá-la, publique essa porta por um túnel ou servidor.
HELENA_WEB_PORT=
HELENA_WEB_HOST=127.0.0.1

# Sites autorizados a chamar a API (a origem, sem barra no fim), separados
# por vírgula. Qualquer outro site é recusado.
HELENA_WEB_ORIGINS=https://helenacry.github.io

# Endereços de retorno do login, escritos EXATAMENTE como cadastrados no
# Portal do Desenvolvedor da VSync (a barra final conta), separados por vírgula.
HELENA_OAUTH_REDIRECTS=https://helenacry.github.io/helena-bot/account/

# ID do aplicativo na VSync (o mesmo do link de convite).
HELENA_OAUTH_CLIENT_ID=
# Opcional: segredo do aplicativo. Sem ele, a troca do código usa só PKCE.
HELENA_OAUTH_CLIENT_SECRET=

# Chave SECRETA do Cloudflare Turnstile (verificação anti-robô nas coletas).
# Sem ela, as coletas funcionam sem verificação e o bot avisa no início.
HELENA_TURNSTILE_SECRET=

# Como o IP do visitante chega atrás de um proxy (vazio = sem proxy):
#   cloudflare  hospedagens atrás da Cloudflare, como o Discloud: o IP real vem em
#               CF-Connecting-IP (X-Forwarded-For só traz o IP da borda). Só use se o
#               app for alcançável SOMENTE por ela.
#   1           outros proxies e túneis (Railway, Tailscale Funnel...): o IP é o ÚLTIMO
#               valor de X-Forwarded-For (o que o proxy mais próximo viu).
HELENA_WEB_TRUST_PROXY=

# Coloque 1 por um tempo, logo depois de publicar a API, para o log mostrar o
# IP que a API enxergou (uma linha por IP, no máximo 20). Serve para conferir
# se o IP real dos visitantes está chegando; desligue depois.
HELENA_WEB_DEBUG_IP=

# ---------------------------------------------------------------------------
# NA NUVEM (veja o README, seção "Hospedagem na nuvem (Railway)")
# ---------------------------------------------------------------------------
# A imagem (Dockerfile) já define estas duas para o volume montado em /data;
# só mexa se montar o volume em outro lugar.
#   HELENA_DATABASE_PATH=/data/helena.db
#   HELENA_WEB_HOST=0.0.0.0
