# Ambiente de PRODUÇÃO (copie para .env e preencha).
# Para testes, use o .env.test.example -> .env.test (npm run start:test).

# Token do bot (Portal do Desenvolvedor da VSync -> aplicativo -> Bot).
VSYNC_BOT_TOKEN=

# IDs dos proprietários da Helena (comandos /dev* e selo DEV no perfil).
# Aceita vários IDs separados por vírgula, em UUID ou numérico.
HELENA_OWNER_ID=

# IDs autorizados a usar os comandos /admin* (separados por vírgula).
HELENA_ADMIN_IDS=

# Banco SQLite do ambiente. Sem a variável, usa ./data/helena.db.
HELENA_DATABASE_PATH=./data/helena.db

# Contadores do servidor de suporte (services/support-stats.mjs).
# Se qualquer um destes estiver vazio, os contadores ficam desligados.
HELENA_SUPPORT_GUILD_ID=
HELENA_USERS_CHANNEL_ID=
HELENA_CLUSTERS_CHANNEL_ID=
HELENA_CLUSTER_TOTAL=1
HELENA_STATS_INTERVAL=300000

# Opcional: imagem de badges do /userinfo.
BADGE_OUTPUT_DIR=./public/userinfo-badges
BADGE_PUBLIC_BASE_URL=
