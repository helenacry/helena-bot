{
  "name": "helena",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file=.env helena.mjs",
    "start:test": "node --env-file=.env.test helena.mjs",
    "start:cloud": "node helena.mjs",
    "db:export": "node --disable-warning=ExperimentalWarning scripts/export-db.mjs",
    "discloud:zip": "node scripts/make-discloud-zip.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "site:data": "node --disable-warning=ExperimentalWarning scripts/site/build-data.mjs",
    "site:card": "node --disable-warning=ExperimentalWarning scripts/site/build-card.mjs",
    "wiki:build": "node --disable-warning=ExperimentalWarning scripts/site/build-wiki.mjs"
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "ws": "^8.22.0"
  }
}
