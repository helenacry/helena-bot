# Ambiente de TESTES (copie para .env.test e preencha).
# Rode com: npm run start:test
#
# Regras para não afetar a produção:
#  - use o token de OUTRO aplicativo/bot do Discord, nunca o da produção;
#  - use um banco diferente (abaixo);
#  - deixe os contadores do servidor de suporte VAZIOS, senão o bot de
#    testes sobrescreve os canais de contagem da produção.

# Token do bot de TESTES.
DISCORD_BOT_TOKEN=

# Seu ID (comandos /dev* e /admin* no bot de testes).
HELENA_OWNER_ID=
HELENA_ADMIN_IDS=

# Banco separado da produção.
HELENA_DATABASE_PATH=./data/helena-test.db

# Contadores do servidor de suporte: manter vazio nos testes.
HELENA_SUPPORT_GUILD_ID=
HELENA_USERS_CHANNEL_ID=
HELENA_CLUSTERS_CHANNEL_ID=
