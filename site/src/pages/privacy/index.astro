---
import Legal from "../../layouts/Legal.astro";
import { SITE } from "../../config";
import Creators from "../../components/ui/Creators.astro";
import { WEB_CONFIG } from "../../../../config/web.mjs";

const claimLogDays = WEB_CONFIG.claimLogDays;
const sessionHours = WEB_CONFIG.sessionTtl / 3600;
const maxSessions = WEB_CONFIG.maxSessionsPerUser;
void [claimLogDays, sessionHours, maxSessions];

const toc = [
  [
    "responsavel",
    "Quem é responsável"
  ],
  [
    "escopo",
    "O que isto cobre"
  ],
  [
    "bot",
    "Dados no bot"
  ],
  [
    "jogo",
    "Dados do jogo"
  ],
  [
    "site",
    "Site e painel"
  ],
  [
    "terceiros",
    "Serviços de terceiros"
  ],
  [
    "bases",
    "Por que usamos"
  ],
  [
    "prazos",
    "Por quanto tempo"
  ],
  [
    "direitos",
    "Seus direitos"
  ],
  [
    "seguranca",
    "Segurança"
  ],
  [
    "menores",
    "Crianças e adolescentes"
  ],
  [
    "exterior",
    "Fora do Brasil"
  ],
  [
    "cookies",
    "Cookies e armazenamento"
  ],
  [
    "mudancas",
    "Mudanças"
  ],
  [
    "contato",
    "Contato"
